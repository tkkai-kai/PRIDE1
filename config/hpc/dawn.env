# Cambridge CSD3 Dawn (pvc9 Intel GPU)
PRIDE_CLUSTER=dawn

# Slurm (see: sacctmgr show assoc user=$USER)
SLURM_ACCOUNT=airr-p97-dawn-gpu
SLURM_PARTITION=pvc9
SLURM_QOS=gpu1
SLURM_GRES=gpu:1
SLURM_TIME=12:00:00

# CSD3 Intel GPU stack (see docs.hpc.cam.ac.uk/hpc/user-guide/pvc-jobs-ML.html)
# Setup once: bash scripts/hpc/setup_dawn_env.sh (on pvc9 via srun)
# intelpython-conda lives under Dawn modulefiles, not the default CSD3 MODULEPATH.
DAWN_MODULEFILES=/usr/local/dawn/software/modulefiles
CONDA_MODULE=intelpython-conda/2024.0.1.3
# Writable user clone of the read-only CSD3 pytorch-gpu env (created by setup_dawn_env.sh).
CONDA_CLONE_SOURCE=pytorch-gpu
CONDA_ENV=pride-dawn
CONDA_ENV_FILE=conda_env_dawn.yml
PRIDE_IMPORT_IPEX=1

# Runtime: Intel XPU for training; OSMesa for MuJoCo (no NVIDIA EGL on pvc9)
PRIDE_DEVICE=xpu
MUJOCO_GL=osmesa
