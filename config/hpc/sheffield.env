# University of Sheffield Stanage H100 baseline runtime.
PRIDE_CLUSTER=sheffield

# The gpu-h100 partition was retired; `gpu` is the general GPU partition and
# covers the a100/h100/h100-nvl nodes. Check `sinfo` if submission is rejected.
SLURM_PARTITION="${SLURM_PARTITION:-gpu}"
SLURM_QOS="${SLURM_QOS:-gpu}"
SLURM_GRES="${SLURM_GRES:-gpu:1}"
SLURM_TIME="${SLURM_TIME:-48:00:00}"
SLURM_EXCLUDE="${SLURM_EXCLUDE:-}"
SLURM_MAIL_USER="${SLURM_MAIL_USER:-${USER}@sheffield.ac.uk}"
SLURM_MAIL_TYPE="${SLURM_MAIL_TYPE:-BEGIN,END,FAIL,TIME_LIMIT}"

# The EL9 compute nodes and the EL7 login nodes carry different module trees:
# Anaconda3/2024.02-1 exists only on EL7, Anaconda3/2025.06-1 only on EL9. List
# both and let activation keep whichever one resolves.
CONDA_MODULE="${CONDA_MODULE:-Anaconda3/2024.02-1}"
CONDA_MODULE_CANDIDATES="${CONDA_MODULE_CANDIDATES:-Anaconda3/2025.06-1 Anaconda3/2024.02-1}"
CONDA_ENV="${CONDA_ENV:-synprefenv}"
# The env is self-contained, so it can be activated by prefix when no base conda
# module is reachable at all.
CONDA_ENV_PREFIX="${CONDA_ENV_PREFIX:-${HOME}/.conda/envs/${CONDA_ENV}}"
PRIDE_DEVICE="${PRIDE_DEVICE:-cuda}"
MUJOCO_GL="${MUJOCO_GL:-egl}"
