# University of Sheffield Stanage — GPU jobs
PRIDE_CLUSTER=sheffield

# Slurm (see: sacctmgr show assoc user=$USER)
SLURM_ACCOUNT=
# Partition/QOS/GRES are overridable from the environment so jobs can target
# gpu (A100), gpu-h100, or gpu-h100-nvl without editing this file, e.g.
#   SLURM_PARTITION=gpu-h100 PRIDE_CLUSTER=sheffield bash scripts/hpc/submit_warmstart_ab.sh
SLURM_PARTITION="${SLURM_PARTITION:-gpu}"
SLURM_QOS="${SLURM_QOS:-gpu}"
SLURM_GRES="${SLURM_GRES:-gpu:1}"
SLURM_TIME="${SLURM_TIME:-48:00:00}"
SLURM_EXCLUDE="${SLURM_EXCLUDE:-}"

# Job mail notifications
SLURM_MAIL_USER="${SLURM_MAIL_USER:-kqian8@sheffield.ac.uk}"
SLURM_MAIL_TYPE="${SLURM_MAIL_TYPE:-BEGIN,END,FAIL,TIME_LIMIT}"

# Modules & conda (create once: conda env create -f conda_env.yml)
# The Aug 2026 maintenance moved the compute nodes to AlmaLinux 9, which serves a
# different module tree than the EL7 login nodes: Anaconda3/2024.02-1 only exists
# on EL7, Anaconda3/2025.06-1 only on EL9. List both and let activation pick.
CONDA_MODULE=Anaconda3/2024.02-1
CONDA_MODULE_CANDIDATES="${CONDA_MODULE_CANDIDATES:-Anaconda3/2025.06-1 Anaconda3/2024.02-1}"
CONDA_ENV=synprefenv
CONDA_ENV_FILE=conda_env.yml
# The env is self-contained, so it can be activated by prefix when no base conda
# module is reachable.
CONDA_ENV_PREFIX="${CONDA_ENV_PREFIX:-${HOME}/.conda/envs/${CONDA_ENV}}"

# Runtime
PRIDE_DEVICE=cuda
MUJOCO_GL=egl
