# University of Sheffield Stanage — GPU jobs
PRIDE_CLUSTER=sheffield

# Slurm (see: sacctmgr show assoc user=$USER)
SLURM_ACCOUNT=
# Overridable so jobs can target gpu / gpu-h100 without editing this file, e.g.
#   SLURM_PARTITION=gpu-h100 PRIDE_CLUSTER=sheffield bash scripts/hpc/submit_warmstart_ab.sh
SLURM_PARTITION="${SLURM_PARTITION:-gpu}"
SLURM_QOS="${SLURM_QOS:-gpu}"
SLURM_GRES="${SLURM_GRES:-gpu:1}"
SLURM_TIME="${SLURM_TIME:-48:00:00}"

# Modules & conda (create once: conda env create -f conda_env.yml)
CONDA_MODULE=Anaconda3/2024.02-1
CONDA_ENV=synprefenv
CONDA_ENV_FILE=conda_env.yml

# Runtime
PRIDE_DEVICE=cuda
MUJOCO_GL=egl
