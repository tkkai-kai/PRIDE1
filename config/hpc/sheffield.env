# University of Sheffield Stanage H100 baseline runtime.
PRIDE_CLUSTER=sheffield

SLURM_PARTITION="${SLURM_PARTITION:-gpu-h100}"
SLURM_QOS="${SLURM_QOS:-gpu}"
SLURM_GRES="${SLURM_GRES:-gpu:1}"
SLURM_TIME="${SLURM_TIME:-48:00:00}"
SLURM_EXCLUDE="${SLURM_EXCLUDE:-}"
SLURM_MAIL_USER="${SLURM_MAIL_USER:-${USER}@sheffield.ac.uk}"
SLURM_MAIL_TYPE="${SLURM_MAIL_TYPE:-BEGIN,END,FAIL,TIME_LIMIT}"

CONDA_MODULE="${CONDA_MODULE:-Anaconda3/2024.02-1}"
CONDA_ENV="${CONDA_ENV:-synprefenv}"
PRIDE_DEVICE="${PRIDE_DEVICE:-cuda}"
MUJOCO_GL="${MUJOCO_GL:-egl}"
